# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored and must never be committed.
#
# Values already exported in your shell always take precedence over this file.

# ---------------------------------------------------------------------------
# AWS -- REQUIRED
# ---------------------------------------------------------------------------

# Key ID of an asymmetric KMS key (NOT the ARN) used to generate each user's
# RSA-2048 key pair and to unwrap their encrypted private key.
# Create one with:
#   aws kms create-key --description "IaaS" --key-spec RSA_2048 --key-usage SIGN_VERIFY
AWS_KMS_KEY_ID=

# Name of the S3 bucket that stores every user's objects. S3 bucket names are
# globally unique across all AWS accounts, so pick a name nobody else has taken.
# It must be globally unique and DNS compatible, and it is created automatically
# on first user registration.
S3_BUCKET_NAME=

# Region for both KMS and S3.
AWS_REGION=eu-central-1

# AWS credentials are NOT configured here. boto3 resolves them through its own
# provider chain: environment variables, ~/.aws/credentials, ~/.aws/config,
# container/instance metadata, or an IAM role. The recommended local setup is:
#   aws configure
#
# The IAM principal needs:
#   kms:GenerateDataKeyPairWithoutPlaintext   on the key above
#   kms:Decrypt                              on the key above
#   s3:CreateBucket, s3:PutObject, s3:GetObject, s3:ListBucket

# ---------------------------------------------------------------------------
# MySQL -- optional, defaults shown
# ---------------------------------------------------------------------------

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=iaas

# Create the schema with:
#   mysql -u root -p < DB/schema.sql
